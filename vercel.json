{
  "version": 2,
  "builds": [
    {
      "src": "api/server.cjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/test.cjs",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "routes": [
    {
      "src": "/api/test",
      "dest": "api/test.cjs"
    },
    {
      "src": "/api(.*)",
      "dest": "api/server.cjs"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}